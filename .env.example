# Environment Variables Example for KAFÉ Shop
# Copy this file to .env.local and fill in your actual credentials.
# NEVER commit your real .env.local file to GitHub!

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_SITE_NAME=KAFÉ Specialty Coffee

# Payment Gateways (Mock or Real)
VIETQR_BANK_ID=MB
VIETQR_ACCOUNT_NO=888888886868
VIETQR_ACCOUNT_NAME=KAFE ROASTERY

# Database connection string (if migrating from mock DB to Postgres/MongoDB)
# DATABASE_URL=postgresql://user:password@localhost:5432/kafe_db
